# WengPixel Backend Configuration
PROJECT_NAME="WengPixel AI Backend"
HOST="0.0.0.0"
PORT=8000
MAX_FILE_SIZE_MB=20

# AI Provider Options:
# BG_REMOVE_PROVIDER: "rembg" (lokal offline) atau "clipdrop" (cloud) atau "unconfigured"
BG_REMOVE_PROVIDER=rembg

# UPSCALE_PROVIDER: "pillow_lanczos" (lokal offline) atau "unconfigured"
UPSCALE_PROVIDER=pillow_lanczos

# Cloud Provider API Keys (Opsional, kosongkan jika memakai lokal)
# CLIPDROP_API_KEY=your_clipdrop_api_key_here
# REPLICATE_API_TOKEN=your_replicate_token_here
